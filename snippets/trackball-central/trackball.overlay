#include <input/processors/runtime-input-processor.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan1;
    };
};

&spi0 {
    status = "okay";

    trackball_central: trackball@1 {
        status = "okay";
        compatible = "pixart,paw3222";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};

// ペリフェラル（split経由）のリスナーを有効化
&peripheral_listener {
    status = "okay";
};

// セントラルのリスナーを有効化し、deviceを紐付け
// レイヤー番号は config/lism.keymap に対応（4=MOUSE, 5=SCROLL, 7/8=GESTURE）
&central_listener {
    status = "okay";
    device = <&trackball_central>;
    input-processors =
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
        <&zip_temp_layer 4 5000>;

    gesture {
        layers = <7>;
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
            <&zip_mouse_gesture>,
            <&zip_xy_scaler 0 1>;
    };

    gesture_l8 {
        layers = <8>;
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
            <&zip_mouse_gesture_l8>,
            <&zip_xy_scaler 0 1>;
    };

    scroller {
        layers = <5>;
        input-processors =
            <&zip_xy_to_scroll_mapper>,
            <&scroll_runtime_input_processor>;   // スクロール速度などを DYA Studio から調整
    };
};

// トラックボールを動かすと MOUSE レイヤーを一時的に有効化（オートマウス）
/ {
    /omit-if-no-ref/ zip_temp_layer: zip_temp_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        require-prior-idle-ms = <350>;
    };
};
// ========================================
// DYA Studio から調整できるスクロール処理の初期値
// ※カーソルには runtime input processor を通さない（通すとカーソルが小さく・カクカクになったため）
// （DYA Studio の「トラックボール」で変更・保存した値がある場合はそちらが優先。
//   初期値に戻すには DYA Studio の「リセット」）
// ========================================


// スクロール: 速度 1/16（従来と同じ）＋慣性
&scroll_runtime_input_processor {
    scale-multiplier = <1>;
    scale-divisor = <16>;
    inertia-enabled;
    inertia-window-ms = <100>;
    inertia-interval-ms = <20>;
    inertia-threshold = <6>;           // スクロール量（1/16 後）で判定
    inertia-decay-percent = <3>;
    inertia-fast-threshold = <0>;
};
